From 23f647fb2a1deef30f3b819d888cb6e58e0c6a71 Mon Sep 17 00:00:00 2001
From: Rong Bao <rong.bao@csmantle.top>
Date: Wed, 21 Jan 2026 10:09:44 +0800
Subject: [PATCH 14/15] CSMANTLE: loongarch: print out CPU population info for
 debugging

---
 arch/loongarch/kernel/acpi.c  | 2 ++
 arch/loongarch/kernel/setup.c | 3 +++
 arch/loongarch/kernel/smp.c   | 2 ++
 3 files changed, 7 insertions(+)

diff --git a/arch/loongarch/kernel/acpi.c b/arch/loongarch/kernel/acpi.c
index 1367ca759468..ea190a19d8d4 100644
--- a/arch/loongarch/kernel/acpi.c
+++ b/arch/loongarch/kernel/acpi.c
@@ -95,6 +95,8 @@ static int set_processor_mask(u32 id, u32 pass)
 	__cpu_number_map[cpuid] = cpu;
 	__cpu_logical_map[cpu] = cpuid;
 
+	pr_info("%s: Populated CPU presence: lid=%u hwid=%u\n", __func__, cpu, cpuid);
+
 	return cpu;
 }
 #endif
diff --git a/arch/loongarch/kernel/setup.c b/arch/loongarch/kernel/setup.c
index 1ba69b954b70..dc509163ce4c 100644
--- a/arch/loongarch/kernel/setup.c
+++ b/arch/loongarch/kernel/setup.c
@@ -135,6 +135,9 @@ static void __init parse_cpu_table(const struct dmi_header *dm)
 	}
         __max_packages++;
 
+        pr_info("cpuname = %s, cores_per_package = %d\n",
+                loongson_sysconf.cpuname,
+                loongson_sysconf.cores_per_package);
 	pr_info("CpuClock = %llu\n", cpu_clock_freq);
 }
 
diff --git a/arch/loongarch/kernel/smp.c b/arch/loongarch/kernel/smp.c
index 405670e3f1fc..968519db02e9 100644
--- a/arch/loongarch/kernel/smp.c
+++ b/arch/loongarch/kernel/smp.c
@@ -343,6 +343,8 @@ static void __init fdt_smp_setup(void)
 
 		early_numa_add_cpu(cpuid, 0);
 		set_cpuid_to_node(cpuid, 0);
+
+		pr_info("%s: Populated CPU presence: lid=%u hwid=%u\n", __func__, cpu, cpuid);
 	}
 
 	loongson_sysconf.nr_cpus = num_processors;
-- 
2.52.0

